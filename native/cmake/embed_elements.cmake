# The builtin element templates (data/elements/<kind>.json, docs/ELEMENTS.md)
# as a C++ source: rcg::elements::embedded::FILES, one {kind, text} per file, so
# the game reads them without a filesystem. Run as a script:
#   cmake -DSRC_DIR=<data/elements> -DOUT=<file.cpp> -P embed_elements.cmake
file(GLOB files "${SRC_DIR}/*.json")
list(SORT files)
set(body "")
set(count 0)
foreach(f IN LISTS files)
	get_filename_component(kind "${f}" NAME_WE)
	file(READ "${f}" text)
	string(APPEND body "\t{\"${kind}\", R\"RCEMBED(${text})RCEMBED\"},\n")
	math(EXPR count "${count} + 1")
endforeach()
file(WRITE "${OUT}.tmp" "// Generated by native/cmake/embed_elements.cmake from data/elements: do not edit.
namespace rcg::elements::embedded {
struct File {
	const char *kind;
	const char *text;
};
extern const File FILES[];
extern const unsigned COUNT;
const File FILES[] = {
${body}	{nullptr, nullptr}};
const unsigned COUNT = ${count};
} // namespace rcg::elements::embedded
")
execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${OUT}.tmp" "${OUT}")
file(REMOVE "${OUT}.tmp")
