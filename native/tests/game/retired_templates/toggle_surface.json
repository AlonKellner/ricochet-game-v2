{
 "doc": "A toggle surface: the hit removes it, and the arrow passing where it was brings it back (a twin pass-through stands in its place while it is gone). Flag el:<name>:off, kept across shots.",
 "label": "Toggle",
 "params": {
  "body": {
   "default": "block",
   "doc": "what the player and objects do: pass, or block (collide with it)",
   "enum": ["pass", "block"]
  },
  "face": {
   "default": "stop",
   "doc": "its sides' face: stop, mirror or pass",
   "enum": ["stop", "mirror", "pass"]
  }
 },
 "priority": 51,
 "surfaces": [
  {
   "left": {
    "effect": {
     "$switch": "face",
     "cases": {
      "mirror": {
       "type": "reflection"
      },
      "pass": {
       "type": "pass"
      },
      "stop": {
       "type": "terminal"
      }
     }
    },
    "hits": [
     {
      "key": "el:${name}:off",
      "kind": "state",
      "op": "set",
      "value": true
     }
    ],
    "interactive": true
   },
   "player_solid": {
    "$switch": "body",
    "cases": {
     "block": true,
     "pass": false
    }
   },
   "presence": [
    {
     "key": "el:${name}:off",
     "values": ["DEFAULT", "false"]
    }
   ],
   "right": {
    "effect": {
     "$switch": "face",
     "cases": {
      "mirror": {
       "type": "reflection"
      },
      "pass": {
       "type": "pass"
      },
      "stop": {
       "type": "terminal"
      }
     }
    },
    "hits": [
     {
      "key": "el:${name}:off",
      "kind": "state",
      "op": "set",
      "value": true
     }
    ],
    "interactive": true
   }
  },
  {
   "label": "ToggleGone",
   "left": {
    "effect": {
     "type": "pass"
    },
    "hits": [
     {
      "key": "el:${name}:off",
      "kind": "state",
      "op": "set",
      "value": false
     }
    ],
    "interactive": false
   },
   "player_solid": false,
   "presence": [
    {
     "key": "el:${name}:off",
     "values": ["true"]
    }
   ],
   "right": {
    "effect": {
     "type": "pass"
    },
    "hits": [
     {
      "key": "el:${name}:off",
      "kind": "state",
      "op": "set",
      "value": false
     }
    ],
    "interactive": false
   }
  }
 ]
}
