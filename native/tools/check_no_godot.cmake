# ctest rc_core_no_godot: fail if anything under RC_CORE_DIR mentions godot-cpp.
# Run as: cmake -DRC_CORE_DIR=<repo>/native/core -P check_no_godot.cmake
if(NOT RC_CORE_DIR)
    message(FATAL_ERROR "RC_CORE_DIR not set")
endif()
file(GLOB_RECURSE files LIST_DIRECTORIES false "${RC_CORE_DIR}/*")
set(offenders "")
foreach(f IN LISTS files)
    file(READ "${f}" content)
    if(content MATCHES "godot_cpp|<godot|\"godot|gdextension_interface")
        list(APPEND offenders "${f}")
    endif()
endforeach()
list(LENGTH files n)
if(offenders)
    list(JOIN offenders "\n  " joined)
    message(FATAL_ERROR "ricochet_core must not depend on Godot; offending files:\n  ${joined}")
endif()
message(STATUS "rc_core_no_godot: ${n} files under ${RC_CORE_DIR} are Godot-free")
