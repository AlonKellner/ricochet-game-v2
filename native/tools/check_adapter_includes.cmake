# ctest godot_adapter_includes (Stage 118): the Godot adapter (native/hosts/godot)
# knows the game through the C API alone -- every #include is rc_api.h, a
# godot-cpp header, a standard header, or the adapter's own.
# Run as: cmake -DRC_ADAPTER_DIR=<repo>/native/hosts/godot -P check_adapter_includes.cmake
if(NOT RC_ADAPTER_DIR)
    message(FATAL_ERROR "RC_ADAPTER_DIR not set")
endif()
file(GLOB_RECURSE files LIST_DIRECTORIES false "${RC_ADAPTER_DIR}/*.cpp" "${RC_ADAPTER_DIR}/*.hpp" "${RC_ADAPTER_DIR}/*.h")
file(GLOB own RELATIVE "${RC_ADAPTER_DIR}" "${RC_ADAPTER_DIR}/*.hpp" "${RC_ADAPTER_DIR}/*.h")
set(offenders "")
foreach(f IN LISTS files)
    file(STRINGS "${f}" includes REGEX "^[ \t]*#[ \t]*include")
    foreach(line IN LISTS includes)
        string(REGEX REPLACE "^[ \t]*#[ \t]*include[ \t]*" "" inc "${line}")
        string(REGEX MATCH "^[<\"][^>\"]*[>\"]" inc "${inc}")
        string(REGEX REPLACE "^[<\"](.*)[>\"]$" "\\1" name "${inc}")
        set(ok FALSE)
        if(name STREQUAL "rc_api.h" OR name MATCHES "^godot_cpp/" OR (inc MATCHES "^<" AND name MATCHES "^[a-z_]+$"))
            set(ok TRUE)
        endif()
        list(FIND own "${name}" i)
        if(NOT i EQUAL -1)
            set(ok TRUE)
        endif()
        if(NOT ok)
            list(APPEND offenders "${f}: ${inc}")
        endif()
    endforeach()
endforeach()
list(LENGTH files n)
if(offenders)
    list(JOIN offenders "\n  " joined)
    message(FATAL_ERROR "the Godot adapter must include only rc_api.h (and godot-cpp, the standard library, its own headers):\n  ${joined}")
endif()
message(STATUS "godot_adapter_includes: ${n} files under ${RC_ADAPTER_DIR} reach the game through rc_api.h alone")
