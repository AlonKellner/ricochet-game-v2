# Godot 4+ specific ignores
.godot/
*.uid
.nomedia
~*.dll

# Godot general
.import/
export.cfg
export_credentials.cfg
*.tmp

# Imported translations (auto-generated from CSV)
*.translation

# Mono / .NET
.mono/
data_*/
mono_crash.*.json

# IDE / Editor
.vscode/
*.swp
*.swo
*~

# GUT testing artifacts
.gut_editor_config.json

# Godot logs
*.log

# OS
.DS_Store
Thumbs.db

# python
__pycache__/
.venv/

# Generated test output
violations.json
# make perf reports (timing is evidence, not committed)
build/

# Precision benchmark outputs (regenerate with make bench)
bench/results/
violations.*.shard*.json

# Native build outputs; native/godot-api/ is tracked on purpose
native/build*/
# The Godot project's build output and copied data (make native)
engines/godot/bin/
engines/godot/data/

# Shadow-run mismatch dumps (native vs GDScript solver)
shadow_mismatches.json
# Claude Code agent worktrees
.claude/worktrees/

# Claude Code agent worktrees (whole repo copies; Godot must not scan them: .claude/.gdignore)
.claude/worktrees/
