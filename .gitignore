# Native (C++ GDExtension) build outputs; native/godot-api/ is tracked on purpose
native/bin/
native/build*/

# Shadow-run mismatch dumps (native vs GDScript solver)
shadow_mismatches.json
# Claude Code agent worktrees
.claude/worktrees/
